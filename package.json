{
  "name": "samurai-pos-v2",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "description": "Caisse bureau hors ligne, tickets 80 mm et synchronisation",
  "scripts": {
    "start": "electron .",
    "preview": "node scripts/preview.cjs",
    "test": "node scripts/test.cjs",
    "cloud": "node scripts/cloud.cjs",
    "build": "node scripts/build.cjs",
    "build:web": "node scripts/build-web.cjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "electron": "40.9.1",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "tn.samurai.pos.v2",
    "productName": "Samurai POS",
    "compression": "store",
    "directories": {
      "output": "release"
    },
    "files": [
      "frontend/**",
      "backend/**",
      "desktop/**",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "artifactName": "Samurai-POS-${version}.exe",
      "signAndEditExecutable": false
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
