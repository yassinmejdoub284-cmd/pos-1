<?xml version="1.0" encoding="utf-8"?>
<!-- Les données de caisse ne partent ni dans la sauvegarde cloud Android ni vers un autre appareil :
     utilisez « Sauvegarder la base » et la synchronisation de l'application. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
